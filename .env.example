# Discord bot token (Developer Portal → Bot → Reset Token)
TOKEN=

# OAuth2 app credentials (Developer Portal → OAuth2)
CLIENT_ID=
CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/callback

# Channel where new applications get posted for review
REVIEW_CHANNEL_ID=

# Optional: channel for the Controls tab's emergency broadcast button.
# Defaults to REVIEW_CHANNEL_ID if left blank.
ANNOUNCE_CHANNEL_ID=

# Comma-separated Discord IDs to bootstrap as "owner" role on first login
OWNER_IDS=

# Optional
PORT=3000
APPLY_URL=http://localhost:3000/apply
SESSION_SECRET=

# How often automatic database backups run, in hours (default 6)
BACKUP_INTERVAL_HOURS=6
